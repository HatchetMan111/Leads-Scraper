[Unit]
Description=LeadScraper + Sales Team (lokale Lead-Recherche, Consulting DACH)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/leadscraper/app
Environment=PORT=8080
Environment=DB_PATH=/var/lib/leadscraper/leads.db
Environment=ICP_FILE=/opt/leadscraper/icp/consulting-dach.json
ExecStart=/usr/bin/python3 /opt/leadscraper/app/app.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
